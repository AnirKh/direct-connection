# The server's settings on the Pi. Installed as /etc/direct-connection.env,
# readable by root and the server only (mode 640, group dc).
# See deploy/pi/SETUP.md and "Server configuration" in the README.

# Production: a link without an Origin is never let in. Behind Funnel every
# link comes from 127.0.0.1, which would otherwise count as "development".
NODE_ENV=production
PORT=3000
# Only Tailscale Funnel reaches it, never the home network directly.
HOST=127.0.0.1
# Funnel is the one proxy in front.
TRUSTED_PROXY_HOPS=1
# Only if Funnel passes /dc on instead of taking it off — see SETUP.md.
#BASE_PATH=/dc

# Copy these four from Render's Environment page yourself. Never paste them
# into a chat.
KNOCK_PUBLIC_KEY=
KNOCK_PRIVATE_KEY=
RESEND_API_KEY=
MAIL_TO=
