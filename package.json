{
  "name": "direct-connection-server",
  "version": "1.0.0",
  "main": "server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.js",
    "prepare": "git config core.hooksPath .githooks || exit 0",
    "test": "node --test \"test/*.test.js\" \"test/integration/*.test.js\"",
    "test:fast": "node --test \"test/*.test.js\"",
    "sync-csp": "node tools/sync-csp.js",
    "check-csp": "node tools/sync-csp.js --check",
    "sync-build": "node tools/sync-build.js",
    "check-build": "node tools/sync-build.js --check",
    "build-vendor": "npx --yes esbuild@0.24.0 vendor/noble-entry.js --bundle --format=iife --minify --legal-comments=none --outfile=vendor/noble.js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "multer": "^2.1.1",
    "resend": "^3.2.0",
    "ws": "^8.18.2"
  },
  "devDependencies": {
    "@noble/curves": "1.6.0",
    "@noble/hashes": "1.5.0"
  }
}
